Subject: [PATCH] indirect draws

---
diff --git a/src/panfrost/genxml/v9.xml b/src/panfrost/genxml/v9.xml
index bd3012a..16445d7 100644
--- a/src/panfrost/genxml/v9.xml
+++ b/src/panfrost/genxml/v9.xml
@@ -622,6 +622,12 @@
     <value name="FP32" value="3"/>
   </enum>
 
+  <enum name="FIFO format">
+    <value name="Auto" value="0"/>
+    <value name="Basic" value="1"/>
+    <value name="Extended" value="2"/>
+  </enum>
+
   <struct name="Primitive">
     <field name="Draw mode" size="8" start="0:0" type="Draw Mode" default="None"/>
     <field name="Index type" size="3" start="0:8" type="Index Type" default="None"/>
@@ -635,6 +641,11 @@
     <field name="Primitive restart" size="1" start="0:19" type="bool"/>
     <field name="Layer index enable" size="1" start="0:20" type="bool"/>
     <field name="Scissor array enable" size="1" start="0:21" type="bool"/>
+    <!-- Same layout as the "Primitive Flags" word of the later Valhall
+         generations (v10+). -->
+    <field name="Position FIFO format" size="2" start="0:22"
+           type="FIFO format"/>
+    <field name="View mask" size="8" start="0:24" type="hex"/>
 
     <field name="Base vertex offset" size="32" start="1:0" type="int"/>
     <field name="Instance offset" size="32" start="2:0" type="uint"/>
diff --git a/src/panfrost/libpan/draw_helper.cl b/src/panfrost/libpan/draw_helper.cl
index a61aa32..661e3a9 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -642,3 +642,123 @@ panlib_draw_index_minmax_search_helper(global uint8_t *index_buffer_ptr,
 }
 
 #endif
+
+#if PAN_ARCH == 9
+
+/* Patches a MALLOC_VERTEX_JOB with the counts read from an indirect draw
+ * command.  The job is added to the chain as NOT_STARTED and only becomes
+ * visible to the hardware once this kernel has patched it; empty draws stay
+ * NULL.  JM only supports single-draw indirect commands (drawCount == 1), so
+ * one invocation of this kernel handles the whole command.
+ */
+KERNEL(1)
+panlib_patch_malloc_vertex_indirect(global VkDrawIndirectCommand *cmd,
+                                    global uint8_t *job,
+                                    global uint32_t *first_vertex_sysval,
+                                    global uint32_t *base_instance_sysval)
+{
+   const uint32_t vertex_count = cmd->vertexCount;
+   const uint32_t instance_count = cmd->instanceCount;
+   const uint32_t first_vertex = cmd->firstVertex;
+   const uint32_t first_instance = cmd->firstInstance;
+
+   const bool is_no_op = vertex_count == 0 || instance_count == 0;
+
+   global struct mali_job_header_packed *job_header =
+      (global struct mali_job_header_packed *)job;
+   pan_unpack(job_header, JOB_HEADER, unpacked_header);
+   pan_pack(job_header, JOB_HEADER, cfg) {
+      memcpy(&cfg, &unpacked_header, sizeof(cfg));
+      cfg.type = is_no_op ? MALI_JOB_TYPE_NULL : MALI_JOB_TYPE_MALLOC_VERTEX;
+   }
+
+   if (is_no_op)
+      return;
+
+   global struct mali_primitive_packed *prim =
+      (global struct mali_primitive_packed *)
+         (job + pan_section_offset(MALLOC_VERTEX_JOB, PRIMITIVE));
+   pan_unpack(prim, PRIMITIVE, unpacked_prim);
+   pan_pack(prim, PRIMITIVE, cfg) {
+      memcpy(&cfg, &unpacked_prim, sizeof(cfg));
+      cfg.index_count = vertex_count;
+      cfg.base_vertex_offset = first_vertex;
+   }
+
+   global struct mali_count_packed *count =
+      (global struct mali_count_packed *)
+         (job + pan_section_offset(MALLOC_VERTEX_JOB, INSTANCE_COUNT));
+   pan_unpack(count, COUNT, unpacked_count);
+   pan_pack(count, COUNT, cfg) {
+      memcpy(&cfg, &unpacked_count, sizeof(cfg));
+      cfg.count = instance_count;
+   }
+
+   if (first_vertex_sysval)
+      *first_vertex_sysval = first_vertex;
+   if (base_instance_sysval)
+      *base_instance_sysval = first_instance;
+}
+
+/* Same as panlib_patch_malloc_vertex_indirect(), but for indexed draws.  Also
+ * patches the index buffer address from firstIndex. */
+KERNEL(1)
+panlib_patch_malloc_vertex_indexed_indirect(
+   global VkDrawIndexedIndirectCommand *cmd, global uint8_t *job,
+   uint64_t index_buffer_ptr, uint32_t index_size,
+   global uint32_t *first_vertex_sysval, global uint32_t *base_instance_sysval)
+{
+   const uint32_t index_count = cmd->indexCount;
+   const uint32_t first_index = cmd->firstIndex;
+   const int32_t vertex_offset = cmd->vertexOffset;
+   const uint32_t instance_count = cmd->instanceCount;
+   const uint32_t first_instance = cmd->firstInstance;
+
+   const bool is_no_op = index_count == 0 || instance_count == 0;
+
+   global struct mali_job_header_packed *job_header =
+      (global struct mali_job_header_packed *)job;
+   pan_unpack(job_header, JOB_HEADER, unpacked_header);
+   pan_pack(job_header, JOB_HEADER, cfg) {
+      memcpy(&cfg, &unpacked_header, sizeof(cfg));
+      cfg.type = is_no_op ? MALI_JOB_TYPE_NULL : MALI_JOB_TYPE_MALLOC_VERTEX;
+   }
+
+   if (is_no_op)
+      return;
+
+   global struct mali_primitive_packed *prim =
+      (global struct mali_primitive_packed *)
+         (job + pan_section_offset(MALLOC_VERTEX_JOB, PRIMITIVE));
+   pan_unpack(prim, PRIMITIVE, unpacked_prim);
+   pan_pack(prim, PRIMITIVE, cfg) {
+      memcpy(&cfg, &unpacked_prim, sizeof(cfg));
+      cfg.index_count = index_count;
+      cfg.base_vertex_offset = vertex_offset;
+   }
+
+   global struct mali_count_packed *count =
+      (global struct mali_count_packed *)
+         (job + pan_section_offset(MALLOC_VERTEX_JOB, INSTANCE_COUNT));
+   pan_unpack(count, COUNT, unpacked_count);
+   pan_pack(count, COUNT, cfg) {
+      memcpy(&cfg, &unpacked_count, sizeof(cfg));
+      cfg.count = instance_count;
+   }
+
+   global struct mali_indices_packed *indices =
+      (global struct mali_indices_packed *)
+         (job + pan_section_offset(MALLOC_VERTEX_JOB, INDICES));
+   pan_unpack(indices, INDICES, unpacked_indices);
+   pan_pack(indices, INDICES, cfg) {
+      memcpy(&cfg, &unpacked_indices, sizeof(cfg));
+      cfg.address = index_buffer_ptr + (uint64_t)first_index * index_size;
+   }
+
+   if (first_vertex_sysval)
+      *first_vertex_sysval = vertex_offset;
+   if (base_instance_sysval)
+      *base_instance_sysval = first_instance;
+}
+
+#endif
