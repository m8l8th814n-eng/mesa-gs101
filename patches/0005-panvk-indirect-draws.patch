+static VkResult
+emit_malloc_vertex_job(struct panvk_cmd_buffer *cmdbuf,
+                       struct panvk_draw_info *draw,
+                       const struct panvk_shader_variant *vs,
+                       const struct panvk_shader_variant *fs,
+                       uint64_t bds_gpu, uint64_t zsd_gpu,
+                       uint64_t tiler_desc)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+
+   struct pan_ptr job = panvk_cmd_alloc_desc(cmdbuf, MALLOC_VERTEX_JOB);
+   if (!job.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   util_dynarray_append(&batch->jobs, job.cpu);
+
+   VkResult result = fill_malloc_vertex_job(cmdbuf, draw, vs, fs, bds_gpu,
+                                            zsd_gpu, tiler_desc, job);
+   if (result != VK_SUCCESS)
+      return result;
+
+   pan_jc_add_job(&batch->vtc_jc, MALI_JOB_TYPE_MALLOC_VERTEX, false, false, 0,
+                  0, &job, false);
+
+   return VK_SUCCESS;
+}
+
+/* Emit one MALLOC_VERTEX_JOB patched from an indirect draw command.  The job
+ * is submitted with a dependency on a helper kernel which fills in the
+ * draw/instance counts, the index buffer address and the vertex/instance
+ * sysvals. */
+static VkResult
+emit_malloc_vertex_job_indirect(struct panvk_cmd_buffer *cmdbuf,
+                                struct panvk_draw_info *draw,
+                                const struct panvk_shader_variant *vs,
+                                const struct panvk_shader_variant *fs,
+                                uint64_t bds_gpu, uint64_t zsd_gpu,
+                                uint64_t tiler_desc,
+                                uint64_t first_vertex_sysval,
+                                uint64_t base_instance_sysval)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+
+   struct pan_ptr job = panvk_cmd_alloc_desc(cmdbuf, MALLOC_VERTEX_JOB);
+   if (!job.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   util_dynarray_append(&batch->jobs, job.cpu);
+
+   VkResult result = fill_malloc_vertex_job(cmdbuf, draw, vs, fs, bds_gpu,
+                                            zsd_gpu, tiler_desc, job);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct panvk_precomp_ctx precomp_ctx = panvk_per_arch(precomp_cs)(cmdbuf);
+
+   if (draw->index.index_size) {
+      panlib_patch_malloc_vertex_indexed_indirect(
+         &precomp_ctx, panlib_1d(1), PANLIB_BARRIER_JM_SUPPRESS_PREFETCH,
+         draw->indirect.buffer_dev_addr, job.gpu,
+         draw->index.buffer_dev_addr, draw->index.index_size,
+         first_vertex_sysval, base_instance_sysval);
+   } else {
+      panlib_patch_malloc_vertex_indirect(
+         &precomp_ctx, panlib_1d(1), PANLIB_BARRIER_JM_SUPPRESS_PREFETCH,
+         draw->indirect.buffer_dev_addr, job.gpu, first_vertex_sysval,
+         base_instance_sysval);
+   }
+
+   /* The patching helper must have completed before the draw job runs. */
+   const unsigned helper_dep = batch->vtc_jc.job_index;
+
+   pan_jc_add_job(&batch->vtc_jc, MALI_JOB_TYPE_MALLOC_VERTEX, false, false,
+                  0, helper_dep, &job, false);
+
+   return VK_SUCCESS;
+}
