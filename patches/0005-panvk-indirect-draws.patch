@@ -144,6 +153,9 @@ VkResult
    panvk_per_arch(cmd_prepare_tiler_context)(struct panvk_cmd_buffer *cmdbuf,
                                              uint32_t layer_idx);
 
+void panvk_per_arch(cmd_reset_tiler_contexts)(struct panvk_cmd_buffer *cmdbuf,
+                                              struct panvk_batch *batch);
