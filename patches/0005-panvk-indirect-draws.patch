          const struct pan_fb_descs fb_descs = {
             .fbd = fbd.cpu,
@@ -256,67 +263,96 @@ panvk_per_arch(cmd_alloc_tls_desc)(struct panvk_cmd_buffer *cmdbuf, bool gfx)
    return VK_SUCCESS;
 }
 
-VkResult
-panvk_per_arch(cmd_prepare_tiler_context)(struct panvk_cmd_buffer *cmdbuf,
-                                          uint32_t layer_idx)
+/* (Re)initialize the tiler descriptors for the current render state.  The
+ * tiler heap is restored to its initial position and every layer group is
+ * described by its own tiler context, carrying the layer_offset/layer_count
+ * of the group (a tiler descriptor can only cover MAX_LAYERS_PER_TILER_DESC
+ * layers).  Called when the tiler descriptors are first set up and before an
+ * already submitted batch is re-issued.
+ */
+void
+panvk_per_arch(cmd_reset_tiler_contexts)(struct panvk_cmd_buffer *cmdbuf,
+                                         struct panvk_batch *batch)
 {
    struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(cmdbuf->vk.base.device->physical);
-   struct panvk_batch *batch = cmdbuf->cur_batch;
-   uint64_t tiler_desc;
-
-   if (batch->tiler.ctx_descs.gpu) {
-      tiler_desc =
-         batch->tiler.ctx_descs.gpu + (pan_size(TILER_CONTEXT) * layer_idx);
-      goto out_set_layer_ctx;
-   }
-
    const struct pan_fb_layout *fb = &cmdbuf->state.gfx.render.fb.layout;
-   uint32_t layer_count = cmdbuf->state.gfx.render.layer_count;
-   batch->tiler.heap_desc = panvk_cmd_alloc_desc(cmdbuf, TILER_HEAP);
-   batch->tiler.ctx_descs =
-      panvk_cmd_alloc_desc_array(cmdbuf, layer_count, TILER_CONTEXT);
-   if (!batch->tiler.heap_desc.gpu || !batch->tiler.ctx_descs.gpu)
-      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   const uint32_t layer_count = cmdbuf->state.gfx.render.layer_count;
 
-   tiler_desc =
-      batch->tiler.ctx_descs.gpu + (pan_size(TILER_CONTEXT) * layer_idx);
+   assert(layer_count > 0);
 
-   pan_pack(&batch->tiler.heap_templ, TILER_HEAP, cfg) {
+   struct mali_tiler_heap_packed heap_templ;
+   pan_pack(&heap_templ, TILER_HEAP, cfg) {
       cfg.size = pan_kmod_bo_size(dev->tiler_heap->bo);
       cfg.base = dev->tiler_heap->addr.dev;
       cfg.bottom = dev->tiler_heap->addr.dev;
       cfg.top = cfg.base + cfg.size;
    }
 
-   pan_pack(&batch->tiler.ctx_templ, TILER_CONTEXT, cfg) {
-      cfg.hierarchy_mask = panvk_select_tiler_hierarchy_mask(
-         phys_dev, &cmdbuf->state.gfx, pan_kmod_bo_size(dev->tiler_heap->bo));
-      cfg.fb_width = fb->width_px;
-      cfg.fb_height = fb->height_px;
-      cfg.heap = batch->tiler.heap_desc.gpu;
-      cfg.sample_pattern = pan_sample_pattern(fb->sample_count);
-   }
-
-   memcpy(batch->tiler.heap_desc.cpu, &batch->tiler.heap_templ,
-          sizeof(batch->tiler.heap_templ));
+   memcpy(batch->tiler.heap_desc.cpu, &heap_templ, sizeof(heap_templ));
 
    struct mali_tiler_context_packed *ctxs = batch->tiler.ctx_descs.cpu;
 
-   assert(layer_count > 0);
    for (uint32_t i = 0; i < layer_count; i++) {
       STATIC_ASSERT(
          !(pan_size(TILER_CONTEXT) & (pan_alignment(TILER_CONTEXT) - 1)));
 
-      memcpy(&ctxs[i], &batch->tiler.ctx_templ, sizeof(*ctxs));
+      const uint32_t layer_offset = i - (i % MAX_LAYERS_PER_TILER_DESC);
+      const uint32_t group_layer_count =
+         MIN2(MAX_LAYERS_PER_TILER_DESC, layer_count - layer_offset);
+
+      pan_pack(&ctxs[i], TILER_CONTEXT, cfg) {
+         cfg.hierarchy_mask = panvk_select_tiler_hierarchy_mask(
+            phys_dev, &cmdbuf->state.gfx,
+            pan_kmod_bo_size(dev->tiler_heap->bo));
+         cfg.fb_width = fb->width_px;
+         cfg.fb_height = fb->height_px;
+         cfg.heap = batch->tiler.heap_desc.gpu;
+         cfg.sample_pattern = pan_sample_pattern(fb->sample_count);
+#if PAN_ARCH >= 9
+         cfg.layer_count = group_layer_count;
+         cfg.layer_offset = layer_offset;
+#endif
+      }
    }
+}
+
+VkResult
+panvk_per_arch(cmd_prepare_tiler_context)(struct panvk_cmd_buffer *cmdbuf,
+                                          uint32_t layer_idx)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   uint64_t tiler_desc;
+
+   if (batch->tiler.ctx_descs.gpu) {
+      tiler_desc =
+         batch->tiler.ctx_descs.gpu + (pan_size(TILER_CONTEXT) * layer_idx);
+      goto out_set_layer_ctx;
+   }
+
+   const uint32_t layer_count = cmdbuf->state.gfx.render.layer_count;
+   batch->tiler.heap_desc = panvk_cmd_alloc_desc(cmdbuf, TILER_HEAP);
+   batch->tiler.ctx_descs =
+      panvk_cmd_alloc_desc_array(cmdbuf, layer_count, TILER_CONTEXT);
+   if (!batch->tiler.heap_desc.gpu || !batch->tiler.ctx_descs.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   panvk_per_arch(cmd_reset_tiler_contexts)(cmdbuf, batch);
+
+   tiler_desc =
+      batch->tiler.ctx_descs.gpu + (pan_size(TILER_CONTEXT) * layer_idx);
 
 out_set_layer_ctx:
-   if (PAN_ARCH >= 9)
+   if (PAN_ARCH >= 9) {
       batch->tiler.ctx.valhall.desc = tiler_desc;
-   else
+      /* The framebuffer descriptor's internal_layer_index is relative to
+       * the layer_offset of the tiler context it references. */
+      batch->tiler.ctx.valhall.layer_offset =
+         layer_idx - (layer_idx % MAX_LAYERS_PER_TILER_DESC);
+   } else {
       batch->tiler.ctx.bifrost.desc = tiler_desc;
+   }
 
    return VK_SUCCESS;
 }
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 76666f3..fab8897 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -42,47 +42,21 @@
 #include "vk_pipeline_layout.h"
 
 #if PAN_ARCH >= 9
-/* Graphics on Valhall (v9) with the JM backend is not implemented yet, only
- * compute is. Recording any graphics command puts the command buffer in an
- * error state.
- */
-static void
-panvk_v9_jm_gfx_unsupported(VkCommandBuffer commandBuffer)
-{
-   VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
-
-   vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_FEATURE_NOT_PRESENT);
-}
-
-/* 2026-10-10: the CmdDraw/CmdDrawIndexed stubs below are replaced by the real
- * MALLOC_VERTEX_JOB implementation further down. Kept (disabled) on purpose.
- */
-#if 0
-VKAPI_ATTR void VKAPI_CALL
-panvk_per_arch(CmdDraw)(VkCommandBuffer commandBuffer, uint32_t vertexCount,
-                        uint32_t instanceCount, uint32_t firstVertex,
-                        uint32_t firstInstance)
-{
-   panvk_v9_jm_gfx_unsupported(commandBuffer);
-}
-
-VKAPI_ATTR void VKAPI_CALL
-panvk_per_arch(CmdDrawIndexed)(VkCommandBuffer commandBuffer,
-                               uint32_t indexCount, uint32_t instanceCount,
-                               uint32_t firstIndex, int32_t vertexOffset,
-                               uint32_t firstInstance)
-{
-   panvk_v9_jm_gfx_unsupported(commandBuffer);
-}
-#endif
 
 /* ------------------------------------------------------------------------
- * Valhall (v9) JM graphics: direct draws through MALLOC_VERTEX_JOB.
+ * Valhall (v9) JM graphics: draws through MALLOC_VERTEX_JOB.
+ *
+ * Direct draws use the final counts; indirect draws are patched from
+ * helper kernels in panlib (draw_helper.cl, PAN_ARCH == 9) that the job
+ * chain depends on.  Layered rendering emits one job per group of layers
+ * and multiview sets the extended position FIFO format + view mask on the
+ * tiler's primitive word.  Occlusion queries and frame-shader
+ * loads/resolves are handled on this path; render passes are shared with
+ * the Bifrost path.
  *
  * Modelled on the CSF (v10) draw code for descriptors/state and on
  * gallium's jm_emit_malloc_vertex_job() for the job layout. Not supported
- * yet: indirect draws, multiview/layered rendering, occlusion queries,
- * frame-shader loads/resolves.
+ * yet: timestamp queries.
  * ------------------------------------------------------------------------ */
 
 static bool
@@ -730,8 +704,238 @@ emit_scissor(struct panvk_cmd_buffer *cmdbuf, struct mali_scissor_packed *out)
    }
 }
 
+/* Fill a MALLOC_VERTEX_JOB for a single group of layers.  @tiler_desc must
+ * reference the tiler context covering the group's layers; one job is
+ * emitted per group when the framebuffer has more layers than
+ * MAX_LAYERS_PER_TILER_DESC.  For indirect draws the counts are patched by a
+ * helper kernel before the job starts.
+ */
+static VkResult
+fill_malloc_vertex_job(struct panvk_cmd_buffer *cmdbuf,
+                       struct panvk_draw_info *draw,
+                       const struct panvk_shader_variant *vs,
+                       const struct panvk_shader_variant *fs,
+                       uint64_t bds_gpu, uint64_t zsd_gpu,
+                       uint64_t tiler_desc, struct pan_ptr job)
+{
+   const struct vk_dynamic_graphics_state *dyns =
+      &cmdbuf->vk.dynamic_graphics_state;
+   const struct vk_rasterization_state *rs = &dyns->rs;
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+
+   const bool secondary_shader = vs->info.vs.secondary_enable && fs != NULL;
+   const bool writes_point_size =
+      vs->info.vs.writes_point_size && draw->prim == MESA_PRIM_POINTS;
+   const bool fs_reads_prim_id = fs ? fs->info.fs.reads_primitive_id : false;
+   const bool writes_prim_id =
+      vs->info.outputs_written & VARYING_BIT_PRIMITIVE_ID;
+   const bool writes_layer = vs->info.outputs_written & VARYING_BIT_LAYER;
+   const bool extended_fifo =
+      writes_point_size || vs->info.vs.needs_extended_fifo;
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, PRIMITIVE, cfg) {
+      cfg.draw_mode = translate_prim(draw->prim);
+      cfg.index_type = index_size_to_index_type(draw->index.index_size);
+      if (writes_point_size)
+         cfg.point_size_array_format = MALI_POINT_SIZE_ARRAY_FORMAT_FP16;
+      cfg.primitive_index_enable = fs_reads_prim_id;
+      cfg.primitive_index_override = writes_prim_id && fs_reads_prim_id;
+      cfg.allow_rotating_primitives = false;
+      cfg.low_depth_cull = cfg.high_depth_cull =
+         vk_rasterization_state_depth_clip_enable(rs);
+      cfg.secondary_shader = secondary_shader;
+      cfg.primitive_restart = draw->index.restart_enable;
+      cfg.layer_index_enable = writes_layer;
+      /* Multiview: the tiler iterates the views in the view mask and picks
+       * the corresponding per-view outputs from the position FIFO.  The
+       * extended FIFO format is needed whenever the point size array or
+       * per-view outputs are present in the FIFO. */
+      cfg.position_fifo_format = extended_fifo
+                                    ? MALI_FIFO_FORMAT_EXTENDED
+                                    : MALI_FIFO_FORMAT_BASIC;
+      cfg.view_mask = cmdbuf->state.gfx.render.view_mask;
+      /* Valhall uses the base vertex offset for both indexed and
+       * non-indexed draws (gallium does the same). */
+      cfg.base_vertex_offset = draw->vertex.base;
+      cfg.instance_offset = 0;
+      cfg.index_count = draw->vertex.count;
+   }
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, INSTANCE_COUNT, cfg) {
+      cfg.count = draw->instance.count;
+   }
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, ALLOCATION, cfg) {
+      if (secondary_shader) {
+         unsigned sz = vs->info.varyings.formats.generic_size_B;
+         cfg.vertex_packet_stride = sz + 16;
+         cfg.vertex_attribute_stride = sz;
+      } else {
+         /* Hardware requirement for "no varyings" */
+         cfg.vertex_packet_stride = 16;
+         cfg.vertex_attribute_stride = 0;
+      }
+   }
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, TILER, cfg) {
+      cfg.address = tiler_desc;
+   }
+
+   emit_scissor(cmdbuf, pan_section_ptr(job.cpu, MALLOC_VERTEX_JOB, SCISSOR));
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, PRIMITIVE_SIZE, cfg) {
+      /* With a point size written by the VS the hardware takes it from the
+       * position packet, otherwise use a fixed size. */
+      if (!writes_point_size) {
+         cfg.fixed_sized = u_reduced_prim(draw->prim) == MESA_PRIM_LINES
+                              ? dyns->rs.line.width
+                              : 1.0f;
+      }
+   }
+
+   pan_section_pack(job.cpu, MALLOC_VERTEX_JOB, INDICES, cfg) {
+      cfg.address = draw->index.index_size
+                       ? draw->index.buffer_dev_addr +
+                            (uint64_t)draw->index.offset *
+                               draw->index.index_size
+                       : 0;
+   }
+
+   float z_min = 0.0f, z_max = 1.0f;
+   if (dyns->vp.viewport_count >= 1)
+      panvk_depth_range(&cmdbuf->state.gfx, &dyns->vp, &z_min, &z_max);
+
+   struct panvk_dcd_flags dcd_flags;
+   build_dcd_flags(cmdbuf, fs, &dcd_flags);
+
+   struct mali_draw_packed *dcd =
+      pan_section_ptr(job.cpu, MALLOC_VERTEX_JOB, DRAW);
+   pan_pack(dcd, DRAW, cfg) {
+      cfg.vertex_array.packet = true;
+      cfg.minimum_z = z_min;
+      cfg.maximum_z = z_max;
