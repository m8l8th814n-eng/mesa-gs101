 #include "genxml/gen_macros.h"
 
+/* A tiler descriptor can only cover a limited number of layers. When a
+ * render pass has more layers than this, layers are split into groups,
+ * each covered by its own tiler descriptor with a different layer_offset.
+ * Mirrors the CSF backend definition.
+ */
+#if PAN_ARCH >= 14
+#define MAX_LAYERS_PER_TILER_DESC 256
+#else
