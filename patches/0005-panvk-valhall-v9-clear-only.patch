Subject: [PATCH] panvk: Valhall v9 on the JM backend, clear-only rendering

Enable the JM framebuffer and fragment job path on v9 so a render pass with
loadOp = CLEAR produces an image. Draws are still not ported.

 - The JM-only render state (fb.bo_count, fb.bos, needs_load, needs_store) was
   guarded by PAN_ARCH < 9; JM runs up to v9, so guard on PAN_ARCH < 10.
 - jm/panvk_vX_cmd_buffer.c: build the FBD, tiler context and fragment job on
   v9 as on Bifrost.
 - jm/panvk_vX_cmd_draw.c: CmdBeginRendering/CmdEndRendering are shared with
   the Bifrost path instead of being stubbed on v9.

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -125,7 +125,7 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
    if (batch->tls.cpu)
       GENX(pan_emit_tls)(&batch->tlsinfo, batch->tls.cpu);
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
    if (batch->fb.desc.cpu &&
        (cmdbuf->cur_batch->vtc_jc.first_tiler ||
         cmdbuf->state.gfx.render.fb.needs_store)) {
@@ -201,7 +201,7 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
       cmdbuf->state.gfx.render.fb.needs_load = false;
    }
 
-#endif /* PAN_ARCH < 9 */
+#endif /* PAN_ARCH < 10 */
 
    cmdbuf->cur_batch = NULL;
 }
@@ -227,7 +227,7 @@ panvk_per_arch(cmd_alloc_fb_desc)(struct panvk_cmd_buffer *cmdbuf)
    fbd_size = ALIGN_POT(fbd_size, pan_alignment(RENDER_TARGET)) +
               (fb->rt_count * pan_size(RENDER_TARGET));
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
    batch->fb.bo_count = cmdbuf->state.gfx.render.fb.bo_count;
    memcpy(batch->fb.bos, cmdbuf->state.gfx.render.fb.bos,
           batch->fb.bo_count * sizeof(batch->fb.bos[0]));
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -87,6 +87,8 @@ panvk_per_arch(CmdDrawIndexedIndirect)(VkCommandBuffer commandBuffer,
    panvk_v9_jm_gfx_unsupported(commandBuffer);
 }
 
+/* Replaced by the real CmdBeginRendering/CmdEndRendering below, which are
+ * shared with the Bifrost path (clear-only rendering on v9).
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdBeginRendering)(VkCommandBuffer commandBuffer,
                                   const VkRenderingInfo *pRenderingInfo)
@@ -99,6 +101,7 @@ panvk_per_arch(CmdEndRendering)(VkCommandBuffer commandBuffer)
 {
    panvk_v9_jm_gfx_unsupported(commandBuffer);
 }
+ */
 #else /* PAN_ARCH < 9 */
 
 struct panvk_draw_data {
@@ -1956,6 +1959,8 @@ panvk_per_arch(CmdDrawIndexedIndirect)(VkCommandBuffer commandBuffer,
    panvk_cmd_draw_indirect(cmdbuf, &draw);
 }
 
+#endif /* PAN_ARCH < 9 */
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdBeginRendering)(VkCommandBuffer commandBuffer,
                                   const VkRenderingInfo *pRenderingInfo)
@@ -2007,5 +2012,3 @@ panvk_per_arch(CmdEndRendering)(VkCommandBuffer commandBuffer)
       panvk_per_arch(cmd_meta_resolve_attachments)(cmdbuf);
    }
 }
-
-#endif /* PAN_ARCH < 9 */
diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -93,7 +93,7 @@ struct panvk_rendering_state {
       /* nr_samples to be used before framebuffer / tiler descriptor are emitted */
       uint32_t nr_samples;
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
       uint32_t bo_count;
       struct pan_kmod_bo *bos[(MAX_RTS * PANVK_MAX_PLANES) + 2];
       bool needs_load;
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/panvk_vX_cmd_draw.c
--- a/src/panfrost/vulkan/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_draw.c
@@ -142,7 +142,7 @@ render_state_set_color_attachment(struct panvk_cmd_buffer *cmdbuf,
    render->color_attachments.fmts[index] = iview->vk.format;
    render->color_attachments.samples[index] = img->vk.samples;
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
    for (uint8_t p = 0; p < ARRAY_SIZE(iview->pview.planes); p++) {
       struct pan_image_plane_ref pref =
          pan_image_view_get_plane(&iview->pview, p);
@@ -316,7 +316,7 @@ render_state_set_zs_attachments(struct panvk_cmd_buffer *cmdbuf,
          MAX2(render->fb.nr_samples,
               pan_image_view_get_nr_samples(&z_iview->pview));
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
       /* Depth plane always comes first. */
       render->fb.bos[render->fb.bo_count++] = z_img->planes[0].mem->bo;
 #endif
@@ -340,7 +340,7 @@ render_state_set_zs_attachments(struct panvk_cmd_buffer *cmdbuf,
          MAX2(render->fb.nr_samples,
               pan_image_view_get_nr_samples(&s_iview->pview));
 
-#if PAN_ARCH < 9
+#if PAN_ARCH < 10
       /* The stencil plane is always last. */
       render->fb.bos[render->fb.bo_count++] =
          s_img->planes[s_img->plane_count - 1].mem->bo;
